# ================== Core ==================
# Which connector to run: sheets | randomuser
CONNECTOR=randomuser

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ================== Random User (public API) ==================
RANDOMUSER_RESULTS=50
RANDOMUSER_PAGES=1
RANDOMUSER_SEED=meiro-demo
# Comma-separated 2-letter country codes (e.g., us,gb). Leave empty to disable.
RANDOMUSER_NAT=us,gb

# ================== Uploader: CSV ==================
# Where CsvUploader writes the file (container path if running in Docker)
OUTPUT_PATH=/app/out/customers.csv

# ================== Uploader: HTTP ==================
# For Docker Desktop on macOS/Windows this works. On Linux, add --add-host=host.docker.internal:host-gateway.
UPLOAD_URL=http://host.docker.internal:8010/ingest
CHUNK_SIZE=100

# ================== Google Sheets ==================
# When running in Docker, scripts will override this to /secrets/sa.json and mount your local file there.
# For local (non-Docker) runs, set this to the absolute path of your service account JSON on your machine.
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# Reader (source)
SHEET_URL_OR_ID=YourSourceSheetIdOrUrl
SHEET_TAB=Sheet1

# Writer (destination)
UPLOAD_SHEET_URL_OR_ID=YourDestSheetIdOrUrl
UPLOAD_SHEET_TAB=Ingested

# ================== Test toggles (integration tests are OFF by default) ==================
# Enable specific integration test suites by setting these to 1 when running pytest.

# Hits randomuser.me (seeded determinism check)
RUN_RANDOMUSER_INTEGRATION=0
# Reads from SHEET_URL_OR_ID (needs creds)
RUN_SHEETS_INTEGRATION=0
# Writes to UPLOAD_SHEET_URL_OR_ID (needs creds)
RUN_SHEETS_WRITE=0
